# name:key pairs, one per agent. Make a key with: openssl rand -hex 32
MCP_KEYS=
# The address of this server, for the links agents get back
PUBLIC_URL=https://pages.example.com
# Optional: each agent's site at https://<site>.pages.example.com/. Needs a wildcard DNS record; read A host per site in the README
SITE_DOMAIN=
# on lets anyone publish without a key. Read Danger mode in the README first
DANGER_MODE=off

# Days of visit and publish counts kept (default 90)
# STATS_DAYS=90
# How long a dashboard link from dashboard_link works, in minutes (default 60)
# DASHBOARD_MINUTES=60
